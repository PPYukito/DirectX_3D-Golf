# ==========================================
# Visual Studio / MSBuild Build Artifacts
# ==========================================
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Bb]uild/
[Bb]in/
[Oo]bj/
$tf/

# Compiled Object files and libraries
*.obj
*.ilk
*.pdb
*.iobj
*.ipdb
*.tlb
*.tli
*.tlh
*.tmp
*.rsp
*.pgc
*.pgd
*.meta
*.lib
*.a
*.dll
*.so
*.exe

# Precompiled Headers
*.pch
*.gch

# ==========================================
# Visual Studio Cache & User Settings
# ==========================================
.vs/
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.suo
*.user
*.vcxproj.user
*.userosscache
*.sln.docstates

# ==========================================
# Direct3D / DirectX Specific Artifacts
# ==========================================
# Compiled Shader Objects (DirectX HLSL compiler output)
*.cso

# Shader cache folders generated by D3D runtime or custom engines
*.shadercache
[Ss]hader[Cc]ache/

# DirectX Agility SDK / NuGet local packages folder (if utilizing NuGet package restore)
packages/
!packages/repositories.config

# ==========================================
# Exceptions: files this project needs
# ==========================================
# Assimp library (needed to build and run)
!assimp-vc143-mt.lib
!assimp-vc143-mt.dll

# 3D models in .obj format (not C++ object files)
!asset/**/*.obj
